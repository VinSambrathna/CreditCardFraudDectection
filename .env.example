# SentinelPay Environment Configuration

# Application
APP_ENV=development
APP_NAME=SentinelPay
PORT=8000
HOST=0.0.0.0

# Database Configuration (Defaults to local SQLite if DB_TYPE is sqlite)
DB_TYPE=sqlite
DATABASE_URL=sqlite:///./sentinelpay.db

# MySQL Production Configuration (Used when DB_TYPE=mysql or Docker)
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=sentinelpay
# DB_USER=sentinel_user
# DB_PASSWORD=sentinel_secure_pass
# DATABASE_URL=mysql+pymysql://sentinel_user:sentinel_secure_pass@localhost:3306/sentinelpay

# Security & Tokens
SECRET_KEY=sentinelpay_super_secret_jwt_key_2026_capstone_demo
MFA_CODE_EXPIRY_SECONDS=300

# ML Operational Risk Thresholds
RISK_THRESHOLD_LOW=0.35
RISK_THRESHOLD_HIGH=0.70
